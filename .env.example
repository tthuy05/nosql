# Server Port
PORT=3000
HOST=127.0.0.1
# Required for /admin and /api/admin/*; username: admin. Set a strong value.
ADMIN_PASSWORD=admin123

# Redis Configuration (Dung 'redis' neu chay Docker Compose, '127.0.0.1' neu chay Windows)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Worker Settings
WORKER_DELAY_MS=2500
WORKER_MAX_RETRIES=3
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_STALE_TIMEOUT_MS=30000

# Demo Settings
NODE_ENV=development
